{
  "name": "relaybox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm run build:css && (tailwindcss -i src/styles.css -o public/styles.css --watch & tsx watch src/index.ts </dev/null)",
    "build:css": "tailwindcss -i src/styles.css -o public/styles.css",
    "build": "pnpm run build:css && tsc",
    "start": "node dist/src/index.js",
    "zen:generate": "zen generate",
    "zen:push": "zen db push",
    "zen:migrate": "zen migrate dev",
    "zen:deploy": "zen migrate deploy",
    "chats:repair-identities": "tsx src/repairChatAliases.ts",
    "lint": "eslint src tests",
    "jscpd": "jscpd",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:file": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "author": "Johanderson Mogollon",
  "license": "MIT",
  "description": "Self-hosted WhatsApp bridge with a dashboard, an Evolution-compatible JSON API, MCP tools, and outbound webhooks",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "@zenstackhq/orm": "^3.9.2",
    "@zenstackhq/schema": "^3.9.2",
    "ajv-formats": "3.0.1",
    "baileys": "^7.0.0-rc14",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "hono": "^4.13.5",
    "ipaddr.js": "^2.5.0",
    "kysely": "0.29.5",
    "multer": "^2.4.0",
    "openapi-backend": "5.21.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "ws": "8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@zenstackhq/cli": "^3.9.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jscpd": "^5.1.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typed-htmx": "^0.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
