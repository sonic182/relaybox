# At least 16 characters; the app refuses to start with this placeholder. Generate one with
# `openssl rand -hex 32`.
API_KEY=changeme-api-key
DB_URL=postgresql://postgres:postgres@localhost:5433/relaybox_dev
LOG_LEVEL=info
LOG_FORMAT=logfmt
# How many due webhook deliveries one worker drain sends at once (default 4).
DELIVERY_CONCURRENCY=4
# Days to keep delivered and failed webhook delivery rows before pruning them (default 7).
# DELIVERY_RETENTION_DAYS=7
# Largest outbound media file in bytes, fetched from a URL or decoded from base64 (default 20 MiB).
# MAX_OUTBOUND_MEDIA_BYTES=20971520
# Optional: write JSON logs to ./logs/app.log in addition to stdout.
# LOG_DIRECTORY=./logs
# How long a dashboard login stays valid, in seconds (default 604800, 7 days).
# SESSION_TTL_SECONDS=604800
# Server port (default 3000).
# PORT=3000
# Behind a reverse proxy, Express `trust proxy` (true, a hop count, or addresses) so login
# rate limits apply per client instead of to the proxy (default unset).
# TRUST_PROXY=1
# Public URL used in webhook envelopes (default http://localhost:PORT).
# SERVER_URL=http://localhost:3000
# Only development and test relax security (any http webhook URL, insecure session cookie,
# the /ui gallery, ENABLE_DEV_MCP); any other value, or unset, is strict. `pnpm run dev` sets
# development itself, so leave this unset here: Docker Compose reads this file too.
# NODE_ENV=development
# Allow webhook callbacks to this host or the local network (localhost, 127.x, 192.168.x, 10.x,
# 172.16-31.x, fd00::/8, .local and .internal names) over plain http. Link-local stays blocked, and public hosts
# still require https. Enable only where you trust everyone holding the API key.
# ALLOW_PRIVATE_WEBHOOK_TARGETS=true
# Optional outbound WebSocket for remote control of instances and webhooks.
# Use wss://; plain ws:// is only accepted for loopback and private hosts.
# REMOTE_SERVER_URL=wss://target.example/relaybox
# REMOTE_SERVER_TOKEN=changeme-remote-token
# Enables the development MCP endpoint at /dev/mcp, for loopback connections only (not
# reachable through Docker port publishing; run `pnpm run dev` on the host).
# This exposes project_eval without authentication; never enable outside local development.
ENABLE_DEV_MCP=false
# Enables the authenticated MCP server at /mcp. Independent of ENABLE_DEV_MCP; this is the
# production-facing surface and requires Authorization: Bearer $API_KEY.
# ENABLE_MCP_SERVER=true
# MCP mount path (default /mcp); must be outside existing HTTP route namespaces.
# MCP_PATH=/mcp
# REQUIRED for remote MCP clients: allowed Host/Origin hostnames, without scheme or port.
# Unset restricts MCP to localhost (other Host headers get 403).
# Also set SERVER_URL to the externally reachable HTTPS URL for signed media downloads.
# MCP_ALLOWED_HOSTS=example.com,mcp.example.com
# Largest inline base64 media payload an MCP tool accepts or returns (default 1048576; 0 disables).
# MCP_INLINE_MEDIA_BYTES=1048576
# Lifetime of a signed media URL, in seconds (default 300).
# MCP_MEDIA_URL_TTL=300
# Base URL of the signed media links MCP tools return, when MCP clients reach the app by a
# different address than webhook receivers (default SERVER_URL).
# MCP_MEDIA_BASE_URL=http://relaybox:3000
